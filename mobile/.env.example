# Copy to .env.local (ignored by git). Where the app finds the FastAPI backend.
# Web and iOS simulator: http://localhost:8000 (keep web on localhost: its sign-in cookie needs
#                        the website and API on the same site)
# Android emulator:      http://10.0.2.2:8000
# A real phone:          your computer's network address, e.g. http://192.168.1.20:8000
#                        (start the backend with: uvicorn main:app --host 0.0.0.0)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Sign in with Google (optional; see README.md). Leave empty to hide the Google button.
# The "Web application" client id: Google gives the app tokens meant for this client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The "iOS" client id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
