# Copy this file to .env and fill in the values. Never commit .env.

# Database
DB_SETTINGS=postgresql+psycopg://user:password@localhost:5432/triplet

# Auth (generate a key with: python secret.py)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# The website, for links in emails (invites go to APP_URL/invites)
APP_URL=http://localhost:8081
PASSWORD_RESET_URL=http://localhost:8081/reset-password
# Sign-up, email changes and password resets email a 6-digit code that works this long
EMAIL_CODE_EXPIRE_MINUTES=15
# Only for confirmation links sent before codes replaced them
EMAIL_VERIFY_EXPIRE_HOURS=48

# Sending email. Leave BREVO_API_KEY and SMTP_HOST empty to print emails in the backend's terminal.
# BREVO_API_KEY sends through Brevo's API over HTTPS (an API key, not the SMTP key). Use it on hosts
# that block email ports, like Render's free plan; the SMTP settings below are then ignored.
BREVO_API_KEY=
# Or SMTP:
# Any provider with SMTP works; port 587 uses STARTTLS. For example:
#   Brevo (300 emails a day free): SMTP_HOST=smtp-relay.brevo.com, SMTP_USERNAME=<your Brevo login>,
#       SMTP_PASSWORD=<an SMTP key from Brevo's SMTP & API page>
#   Resend (100 a day free):       SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend,
#       SMTP_PASSWORD=<an API key>; SMTP_FROM must use a domain you've verified with Resend
#   Gmail, for testing:            SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=<you>@gmail.com,
#       SMTP_PASSWORD=<an app password from myaccount.google.com/apppasswords, not your normal password>
# SMTP_FROM should be an address your provider lets you send from, or emails land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Triplet <no-reply@triplet.app>

# Video extraction. Get a free key at https://aistudio.google.com. Leave empty to turn it off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FILESIZE_MB=100

# Place lookups (address, map pin, opening hours).
# auto = Google when GOOGLE_PLACES_API_KEY is set, otherwise OpenStreetMap (free). none = users fill in details themselves.
PLACE_LOOKUP_PROVIDER=auto
# OpenStreetMap requires apps to identify themselves
OSM_USER_AGENT=Triplet/1.0 (+https://github.com/uwuexdeemeow/Triplet)

# Optional. Set a daily quota in Google Cloud Console a little above PLACES_DETAILS_DAILY_LIMIT as a backstop.
GOOGLE_PLACES_API_KEY=
PLACES_DETAILS_DAILY_LIMIT=30
PLACES_SEARCH_DAILY_LIMIT=150

# Browser origins allowed to call the API (the Expo web dev server). Phone apps don't need this.
# Exact origins only: the website signs in with a cookie, so it must be on the same site as the API.
CORS_ORIGINS=["http://localhost:8081"]

# "production" when deployed: hides the API docs and turns on HSTS
ENVIRONMENT=development
# Print every SQL query (handy locally; never in production, it logs emails)
SQL_ECHO=false
# Slows down password guessing and abuse; leave on
RATE_LIMITS_ENABLED=true
# Posts each person can save or re-check per day (each one costs an AI call)
LINK_SAVES_DAILY_LIMIT=40
