# Copy this file to .env and fill in the values. Never commit .env.

# Database
DB_SETTINGS=postgresql+psycopg://user:password@localhost:5432/triplet

# Auth (generate a key with: python secret.py)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Password reset emails. Leave SMTP_HOST empty to print emails to the console instead.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Triplet <no-reply@triplet.app>

# Video extraction. Get a free key at https://aistudio.google.com. Leave empty to turn it off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FILESIZE_MB=100

# Place lookups (address, map pin, opening hours).
# auto = Google when GOOGLE_PLACES_API_KEY is set, otherwise OpenStreetMap (free). none = users fill in details themselves.
PLACE_LOOKUP_PROVIDER=auto
# OpenStreetMap requires apps to identify themselves
OSM_USER_AGENT=Triplet/1.0 (+https://github.com/uwuexdeemeow/Triplet)

# Optional. Set a daily quota in Google Cloud Console a little above PLACES_DETAILS_DAILY_LIMIT as a backstop.
GOOGLE_PLACES_API_KEY=
PLACES_DETAILS_DAILY_LIMIT=30
PLACES_SEARCH_DAILY_LIMIT=150

# Browser origins allowed to call the API (the Expo web dev server). Phone apps don't need this.
CORS_ORIGINS=["http://localhost:8081"]
